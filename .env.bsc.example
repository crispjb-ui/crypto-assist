# BNB Smart Chain profile. Activate for one command with:
#   PowerShell:  $env:CRYPTO_ASSIST_ENV=".env.bsc"; python -m src.onchain.report 0x...
# Run a second dashboard alongside the Robinhood one with CRYPTO_ASSIST_PORT=8538.
#
# The generic pipeline (report, scan, holders, clusters, dashboard quick-scan)
# works on BSC as-is. The launchpad watchers (pons.py / long.py) are
# Robinhood-chain contracts and do NOT apply here — bootstrap a BSC launchpad
# watcher (e.g. Four.meme) by running derive_factory.py on a token it launched.

# Your dRPC endpoint for BSC, or the public one below (rate-limited).
EVM_RPC_URL=https://bsc-dataseed.binance.org
EVM_CHAIN_ID=56

# Etherscan-family API for BSC. Requires a (free) API key from bscscan.com.
# Newer Etherscan accounts use the unified endpoint instead:
#   https://api.etherscan.io/v2/api?chainid=56
EXPLORER_API_URL=https://api.bscscan.com/api
EXPLORER_API_KEY=

DEXSCREENER_CHAIN_ID=bsc
NATIVE_SYMBOL=BNB

MAX_LOG_BLOCK_RANGE=5000
EARLY_WINDOW_SECONDS=60
MAX_EARLY_BUYERS=40
