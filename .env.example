# --- Required ---
# Full JSON-RPC URL for your target EVM chain (paid endpoint recommended).
# Robinhood Chain public endpoint (rate-limited, fine for a first test):
#   https://rpc.mainnet.chain.robinhood.com
# For real use, paste your dRPC endpoint for Robinhood Chain instead.
EVM_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Strongly recommended ---
# Etherscan/Blockscout-compatible explorer API base for the chain.
# Enables funding-source tracing and contract-source checks.
EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api
EXPLORER_API_KEY=

# --- Optional ---
# Sanity check: fail fast if the RPC serves a different chain.
# Robinhood Chain mainnet is 4663.
EVM_CHAIN_ID=4663

# DexScreener chain slug for scan/pair discovery, if the chain is indexed.
# Robinhood Chain is indexed as "robinhood" (dexscreener.com/robinhood).
DEXSCREENER_CHAIN_ID=robinhood

# Native token symbol, display only.
NATIVE_SYMBOL=ETH

# Caps to control RPC spend.
MAX_LOG_BLOCK_RANGE=5000        # blocks per eth_getLogs request
EARLY_WINDOW_BLOCKS=20          # "early buyer" = bought within N blocks of pair creation
MAX_EARLY_BUYERS=40             # deep-check at most this many wallets
